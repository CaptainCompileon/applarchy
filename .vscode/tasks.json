{
  // ⇧⌘B: build "Applarchy DEV", install it to ~/Applications and open it.
  "version": "2.0.0",
  "tasks": [
    {
      "label": "Install Applarchy DEV",
      "type": "shell",
      "command": "scripts/dev.sh",
      "group": { "kind": "build", "isDefault": true },
      "problemMatcher": ["$swiftc"]
    },
    {
      "label": "Build release (dist/Applarchy.app)",
      "type": "shell",
      "command": "scripts/build.sh",
      "options": { "env": { "APPLARCHY_FLAVOR": "release" } },
      "group": "build",
      "problemMatcher": ["$swiftc"]
    },
    {
      "label": "Engine tests (cargo test)",
      "type": "shell",
      "command": "cargo test",
      "options": { "cwd": "${workspaceFolder}/engine" },
      "group": "test",
      "problemMatcher": ["$rustc"]
    }
  ]
}
